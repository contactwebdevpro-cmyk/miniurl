{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/:slug([a-z0-9]{4,10})", "destination": "/api/redirect?slug=:slug" },
    { "source": "/", "destination": "/index.html" }
  ],
  "functions": {
    "api/shorten.js": { "maxDuration": 10 },
    "api/redirect.js": { "maxDuration": 10 },
    "api/stats.js":    { "maxDuration": 10 }
  }
}
